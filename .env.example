# ==============================================================================
# YelpCamp Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Database Connection (REQUIRED)
# ------------------------------------------------------------------------------
# Connect to your local MongoDB instance or MongoDB Atlas cloud database.
# Local: mongodb://127.0.0.1:27017/yelpcamp
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/yelpcamp?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/yelpcamp

# ------------------------------------------------------------------------------
# 2. NextAuth Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# Canonical URL of your site.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000
# A random secret string used to hash tokens and sign cookies (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# ------------------------------------------------------------------------------
# 3. OAuth Providers (OPTIONAL - email/password signup works without these)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (obtain from Google Cloud Console: https://console.cloud.google.com/)
GOOGLE_ID=your_google_client_id
GOOGLE_SECRET=your_google_client_secret

# GitHub OAuth App Credentials (obtain from GitHub -> Settings -> Developer Settings -> OAuth Apps)
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret

# ------------------------------------------------------------------------------
# 4. Firebase Storage Configuration (REQUIRED FOR IMAGE UPLOADS)
# ------------------------------------------------------------------------------
# Web API Key for your Firebase project (used for uploading campground photos to Firebase Storage)
# Obtain from Firebase Console -> Project Settings -> General -> Web API Key
FIREBASE_KEY=your_firebase_web_api_key

# ------------------------------------------------------------------------------
# 5. Stripe Payments Configuration (REQUIRED FOR BOOKINGS & SUBSCRIPTIONS)
# ------------------------------------------------------------------------------
# Publishable key and Secret key from Stripe Dashboard (https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key
STRIPE_PRIVATE_KEY=sk_test_your_stripe_secret_key
# Stripe Webhook Signing Secret (from Stripe CLI or Dashboard Webhooks: https://dashboard.stripe.com/test/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 6. Mapbox & Geoapify (REQUIRED FOR MAPS & REVERSE GEOCODING)
# ------------------------------------------------------------------------------
# Mapbox Public Access Token (obtain from Mapbox account dashboard: https://account.mapbox.com/)
NEXT_PUBLIC_MAPBOX_ACCESS_KEY=pk.eyJ1IjoieW91ciIsImEiOiJ5b3VyLXRva2VuIn0.example
# Geoapify API Key for reverse geocoding campground location coordinates (obtain from https://myprojects.geoapify.com/)
NEXT_PUBLIC_GEOAPIFY_KEY=your_geoapify_api_key
